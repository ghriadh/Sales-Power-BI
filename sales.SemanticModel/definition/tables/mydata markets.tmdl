table 'mydata markets'
	lineageTag: 0be02185-4a62-4dee-ab0f-45eee4c607e0

	column markets_code
		dataType: string
		lineageTag: bdb76e91-0c1b-42ea-ab3b-5923c5ae14e7
		summarizeBy: none
		sourceColumn: markets_code

		annotation SummarizationSetBy = Automatic

	column markets_name
		dataType: string
		lineageTag: 7ca9b75e-3970-4158-ab0b-2f73818d24cb
		summarizeBy: none
		sourceColumn: markets_name

		annotation SummarizationSetBy = Automatic

	column zone
		dataType: string
		lineageTag: 8f7a89ba-a987-4cb6-b6ff-a256fbb4727b
		summarizeBy: none
		sourceColumn: zone

		annotation SummarizationSetBy = Automatic

	partition 'mydata markets' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "markets.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    mydata_markets = Table.TransformColumnTypes(#"Promoted Headers", {{"markets_code", type text}, {"markets_name", type text}, {"zone", type text}}, "en-US"),
				    #"Filtered Rows" = Table.SelectRows(mydata_markets, each ([zone] <> "")),
				    #"Fixed Duplicate Name" = Table.ReplaceValue(#"Filtered Rows", each [markets_name], each if [markets_code] = "Mark013" then "Bhopal (2)" else [markets_name], Replacer.ReplaceValue, {"markets_name"})
				in
				    #"Fixed Duplicate Name"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

