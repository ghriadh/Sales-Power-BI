	partition 'mydata date' = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "date.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    mydata_date = Table.TransformColumnTypes(#"Promoted Headers", {{"date", type date}, {"cy_date", type date}, {"year", Int64.Type}, {"month_name", type text}, {"date_yy_mmm", type text}}, "en-US"),
				    #"Added Custom" = Table.AddColumn(mydata_date, "Custom", each Date.Month([date])),
				    #"Renamed Columns" = Table.RenameColumns(#"Added Custom",{{"Custom", "month_nb"}}),
				    #"Filtered Rows" = Table.SelectRows(#"Renamed Columns", each [date] >= #date(2017, 10, 1))
				in
				    #"Filtered Rows"

