	column 'Order Size' =
			VAR R = 'mydata transactions'[sales_amount]
			RETURN
			    SWITCH(TRUE(), R < 1000, "< 1K", R < 10000, "1K-10K", R < 100000, "10K-100K", R < 1000000, "100K-1M", "> 1M")
		dataType: string
		lineageTag: eef7e4cb-dd31-4e4b-953f-78a8f5173dc4
		summarizeBy: none
		sortByColumn: 'Order Size Rank'

		annotation SummarizationSetBy = Automatic

	column 'Order Size Rank' =
			VAR R = 'mydata transactions'[sales_amount]
			RETURN
			    SWITCH(TRUE(), R < 1000, 1, R < 10000, 2, R < 100000, 3, R < 1000000, 4, 5)
		dataType: int64
		isHidden
		formatString: 0
