	partition 'mydata transactions' = m
		mode: import
		source =
				let
				    Source = Csv.Document((if Text.StartsWith(DataFolder, "http") then Web.Contents(DataFolder & "transactions.csv") else File.Contents(DataFolder & "transactions.csv")), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    mydata_transactions = Table.TransformColumnTypes(#"Promoted Headers", {{"product_code", type text}, {"customer_code", type text}, {"market_code", type text}, {"order_date", type date}, {"sales_qty", Int64.Type}, {"sales_amount", type number}, {"currency", type text}, {"profit_margin_percentage", type number}, {"profit_margin", type number}, {"cost_price", type number}}, "en-US"),
				    #"Filtered Rows" = Table.SelectRows(mydata_transactions, each true),
				    #"Sorted Rows" = Table.Sort(#"Filtered Rows",{{"order_date", Order.Ascending}}),
				    #"Added Conditional Column" = Table.AddColumn(#"Sorted Rows", "sales_mnt", each if [currency] = "USD" then 75 else if [currency] = "INR" then 1 else "NA"),
				    #"Reordered Columns1" = Table.ReorderColumns(#"Added Conditional Column",{"product_code", "customer_code", "market_code", "order_date", "sales_qty", "sales_amount", "sales_mnt", "currency", "profit_margin_percentage", "profit_margin", "cost_price"}),
				    #"Added Custom" = Table.AddColumn(#"Reordered Columns1", "sale_mnt", each [sales_amount]*[sales_mnt]),
				    #"Reordered Columns" = Table.ReorderColumns(#"Added Custom",{"product_code", "customer_code", "market_code", "order_date", "sales_qty", "currency", "sales_amount", "sales_mnt", "sale_mnt", "profit_margin_percentage", "profit_margin", "cost_price"}),
				    #"Filtered Rows1" = Table.SelectRows(#"Reordered Columns", each true),
				    #"Renamed Columns" = Table.RenameColumns(#"Filtered Rows1",{{"sales_amount", "sale_amount"}, {"sale_mnt", "sales_amount"}, {"sales_mnt", "cur_value"}}),
				    #"Reordered Columns2" = Table.ReorderColumns(#"Renamed Columns",{"product_code", "customer_code", "market_code", "order_date", "sales_qty", "currency", "cur_value", "sale_amount", "sales_amount", "profit_margin_percentage", "profit_margin", "cost_price"}),
				    #"Changed Type" = Table.TransformColumnTypes(#"Reordered Columns2",{{"sales_amount", type number}})
				in
