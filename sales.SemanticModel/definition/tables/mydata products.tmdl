table 'mydata products'
	lineageTag: 7df39735-a4f7-4b8e-9655-999b162adc5b

	column product_code
		dataType: string
		lineageTag: df540ad6-bfc1-425d-897b-562e5052289d
		summarizeBy: none
		sourceColumn: product_code

		annotation SummarizationSetBy = Automatic

	column product_type
		dataType: string
		lineageTag: 625247e0-664a-4958-bb15-98d18ec14fed
		summarizeBy: none
		sourceColumn: product_type

		annotation SummarizationSetBy = Automatic

	partition 'mydata products' = m
		mode: import
		source =
				let
				    Source = Csv.Document((if Text.StartsWith(DataFolder, "http") then Web.Contents(DataFolder & "products.csv") else File.Contents(DataFolder & "products.csv")), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    mydata_products = Table.TransformColumnTypes(#"Promoted Headers", {{"product_code", type text}, {"product_type", type text}}, "en-US"),
				    #"Fixed Product Code" = Table.ReplaceValue(mydata_products, "prod339", "Prod339", Replacer.ReplaceValue, {"product_code"}),
				    #"Unknown Type" = Table.TransformColumns(#"Fixed Product Code", {{"product_type", each if _ = null or _ = "" then "Unknown" else _, type text}})
				in
				    #"Unknown Type"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

