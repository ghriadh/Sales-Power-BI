table 'KPI Selector'
	lineageTag: 499f8147-4c35-4677-880f-823af25fb729

	measure 'Selected KPI' = SELECTEDVALUE('KPI Selector'[Value], "Revenue")
		displayFolder: KPI Selector
		lineageTag: aeaa6ab2-49da-43e3-a87d-a636caafc15d

	/// Value of the KPI chosen in the KPI slicer
	measure 'KPI Value' =
			SWITCH(
			    [Selected KPI],
			    "Revenue", [Revenue],
			    "Profit", [Profit],
			    "Profit Rate", [Profit Margin %],
			    "Quantity", [Quantity],
			    "Transaction", [Transactions],
			    "Cost", [Cost],
			    [Revenue]
			)
		displayFolder: KPI Selector
		lineageTag: ef608870-6065-4505-adbd-730c4c1842ca

	column Index
		dataType: int64
		formatString: 0
