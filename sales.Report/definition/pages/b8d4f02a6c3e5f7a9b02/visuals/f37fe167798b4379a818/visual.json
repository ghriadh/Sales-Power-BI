  "visual": {
    "visualType": "textbox",
    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "1. Audit pricing and discounts per deal, ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt",
                      "color": "#c55a11"
                    }
                  },
                  {
                    "value": "and check the cost data. Use the Watchlist to pick the first products: recurring losses and margins that turned negative.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#252423"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "4pt",
                      "color": "#252423"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "2. Win back volume. ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt",
                      "color": "#c55a11"
                    }
                  },
                  {
                    "value": "Price is not the problem, quantities are. Start with the markets declining faster than the company (Surat, Bhopal (2)).",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#252423"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "4pt",
                      "color": "#252423"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "3. Understand the E-Commerce drop ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt",
                      "color": "#c55a11"
                    }
                  },
                  {
                    "value": "before investing more in it, then grow it where it is profitable.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#252423"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "4pt",
                      "color": "#252423"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "4. Reduce concentration risk. ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt",
                      "color": "#c55a11"
                    }
                  },
                  {
                    "value": "Losing Electricalsara Stores would cut 42% of revenue: widen the customer base outside Delhi NCR.",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#252423"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontSize": "4pt",
                      "color": "#252423"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "5. Retain and simplify. ",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontSize": "10pt",
                      "color": "#c55a11"
                    }
                  },
                  {
                    "value": "Run a retention plan for the 5 at-risk customers, confirm whether Bengaluru is closed or dormant, and rethink very small orders (61% of transactions, 2.7% of revenue).",
                    "textStyle": {
                      "fontSize": "9pt",
                      "color": "#252423"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
